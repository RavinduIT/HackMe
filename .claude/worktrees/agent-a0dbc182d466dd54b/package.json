{
  "name": "hackme",
  "version": "1.0.0",
  "description": "Web Application Security Scanner & Intercepting Proxy",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -n electron,vite -c blue,green \"tsc -p tsconfig.electron.json --watch\" \"vite\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win --publish never",
    "pack:portable": "npm run build && electron-builder --win portable --publish never",
    "pack:all": "npm run build && electron-builder --win --mac --linux --publish never",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3"
  },
  "author": "RavinduIT",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.19.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.1",
    "undici": "^8.5.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "@electron/rebuild": "^4.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.2"
  }
}
